{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "shell:allow-open",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "name": "whisper-service",
          "cmd": "open",
          "args": [
            "https://api.sagt.ai/*"
          ]
        },
        {
          "name": "external-https",
          "cmd": "open",
          "args": [
            "https://*/*"
          ]
        },
        {
          "name": "external-start",
          "cmd": "open",
          "args": [
            "http://*/*"
          ]
        }
      ]
    }
  ]
}