<plist version="1.0">
<dict>
    <!-- Hardened runtime (krävs för notarisering) blockerar ljudåtkomst utan denna. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- ⚠️ com.apple.security.cs.disable-library-validation är MEDVETET utelämnad.
